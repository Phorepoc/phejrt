diff --git a/cldc/src/vm/os/linux/OsMemory_linux.cpp b/cldc/src/vm/os/linux/OsMemory_linux.cpp
index e61a64a3f..7c1ab3c7f 100644
--- a/cldc/src/vm/os/linux/OsMemory_linux.cpp
+++ b/cldc/src/vm/os/linux/OsMemory_linux.cpp
@@ -135,6 +135,26 @@ static inline size_t page_align_up(size_t size) {
   return align_size_up(size, SysPageSize);
 }
 
+#ifdef __SYMBIAN32__
+// Phorepoc: Open C has no anonymous mmap or mprotect. A chunk is one heap block of its maximum size, committed at once;
+// growing within it always succeeds and the protection calls are no-ops.
+static inline address anon_mmap(address addr, size_t size) {
+  if (addr != NULL) {
+    return NULL;  // the caller (adjust_chunk) tests NULL: no growth past the maximum
+  }
+  // page-aligned block from malloc; the word before it keeps the block's start for jvm_munmap
+  char* raw = (char*)::malloc(size + SysPageSize + sizeof(void*));
+  if (raw == NULL) {
+    return (address)MAP_FAILED;
+  }
+  char* p = (char*)(((size_t)raw + sizeof(void*) + SysPageSize - 1) & ~(size_t)(SysPageSize - 1));
+  ((void**)p)[-1] = raw;
+  return (address)p;
+}
+static inline int protect_area(address ptr, size_t size) { return 0; }
+static inline int unprotect_area(address ptr, size_t size) { return 0; }
+#define jvm_munmap(a, s) (::free(((void**)(a))[-1]), 0)
+#else
 static inline address anon_mmap(address addr, size_t size) {
   return (address)jvm_mmap(addr, size, 
                            PROT_EXEC | PROT_WRITE | PROT_READ,
@@ -150,6 +170,8 @@ static inline int unprotect_area(address ptr, size_t size) {
   return mprotect(ptr, size, PROT_READ | PROT_WRITE | PROT_EXEC);
 }
 
+#endif // __SYMBIAN32__
+
 address OsMemory_allocate_chunk(size_t initial_size,
                                 size_t max_size, size_t alignment)
 {
