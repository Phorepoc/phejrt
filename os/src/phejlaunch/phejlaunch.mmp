// phejlaunch -- the per-suite launcher template: the packer (recipes/j5-pack.py) copies the image with a suite's own UID3
TARGET          phejlaunch.exe
TARGETTYPE      exe
UID             0x100039CE 0xE5A0FF01
CAPABILITY      None
VENDORID        0

OS_LAYER_SYSTEMINCLUDE
SOURCEPATH      .
SOURCE          phejlaunch.cpp
LIBRARY         euser.lib efsrv.lib
